
DPI=300

TOP_MARGIN_INCHES=0.6

BOTTOM_MARGIN_INCHES=0.6

LEFT_MARGIN_INCHES=0.78

# Right: 0.6 inches (1.5 cm)
RIGHT_MARGIN_INCHES=0.6

# FONT CONFIGURATION
# Font size in points (standard document: 11-12pt)
FONT_SIZE_PT=12

# LINE SPACING
# 1.0 = Single spacing
# 1.5 = 1.5 line spacing
# 2.0 = Double spacing
LINE_SPACING_MULTIPLIER=1.0

# PARAGRAPH SPACING
# Space after paragraph in points
PARAGRAPH_SPACING_PT=6

# === DIRECTORIES ===
FONT_DIR=fonts/
BACKGROUND_IMAGES_DIR={"white": "#ffffff"}
SAVE_DIR=synthetic_images/
LABEL_DIR=synthetic_labels/
XML_DIR=synthetic_xml_labels/

# === TEXT SOURCE ===
TEXT_FILE=combine_clean.txt
USE_SPECIFIC_TEXT=false
SPECIFIC_TEXT_FILE=specific_text.txt

# How many words per image (random range)
MIN_PARAG_LENGTH=50
MAX_PARAG_LENGTH=500

# === BOUNDING BOX SETTINGS ===
BBOX_WIDTH_PADDING=1
BBOX_HEIGHT_PADDING=3

# === IMAGE EFFECTS (Optional) ===

# JPEG Compression Artifacts
ARTIFACT_POSSIBILITIES=0.3
JPEG_COMPRESSION_RANGE=70,95

# Motion Blur
MOTION_BLUR_POSSIBILITIES=0.2
MOTION_BLUR_KERNEL_SIZE_RANGE=3,3

# Brightness/Contrast Adjustment
ALPHA_RANGE=0.9,1.1
BETA_RANGE=-20,20

# Color Jitter
COLOR_JITTER_POSSIBILITES=0.2
HUE_DELTA=10
SAT_SCALE=0.9,1.1
VAL_SCALE=0.9,1.1

# === VARIATIONS (Keep low for document-like appearance) ===
POSSIBILITIES_FOR_NEW_FONT=0.001
POSSIBILITIES_FOR_NEW_Y=0.001
NEW_Y_RANGE=-2,2
POSSIBILITIES_FOR_NEW_X=0.001
NEW_X_RANGE=-2,2
POSSIBILITIES_FOR_NEW_COLOR=0.001

# Color Settings
CANDIDATE_COLORS={"black":[0,0,0]}
MIN_DISTANCE=200